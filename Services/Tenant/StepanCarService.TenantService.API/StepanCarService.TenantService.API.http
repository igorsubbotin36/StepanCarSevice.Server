@host = http://localhost:5010
# Portal token (GodMode or TenantOwner) from the Auth service, obtained on the root domain
@token = <access token>
@tenantId = <tenant id>

### Public catalog of connected car services (no auth): active tenants only, name + identifier
# The portal builds links as https://{identifier}.<portal domain>
GET {{host}}/api/Tenant/getConnectedTenants

### Register tenant: id is generated by the server
# A TenantOwner becomes the owner; one tenant per owner (409 otherwise)
# identifier: 3-63 chars a-z, 0-9, '-', no leading/trailing '-', not management/www/api
POST {{host}}/api/Tenant/registerTenant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "identifier": "my-tenant",
  "name": "My car service"
}

### Owner's own tenant (TenantOwner)
GET {{host}}/api/Tenant/getMyTenant
Authorization: Bearer {{token}}

### Get tenant: GodMode or the tenant's owner
GET {{host}}/api/Tenant/getTenantById?id={{tenantId}}
Authorization: Bearer {{token}}

### Update tenant (identifier cannot be changed; isActive is GodMode-only, omit to keep)
PATCH {{host}}/api/Tenant/updateTenant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": "{{tenantId}}",
  "name": "My car service (renamed)"
}

### All tenants (GodMode only)
GET {{host}}/api/Tenant/getAllTenants
Authorization: Bearer {{token}}

### Delete tenant (GodMode or owner); tenant users are deleted with it
DELETE {{host}}/api/Tenant/deleteTenant?id={{tenantId}}
Authorization: Bearer {{token}}
