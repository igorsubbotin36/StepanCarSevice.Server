@host = http://localhost:5010
# GodMode or TenantOwner token from the Auth service
@token = <access token>
@tenantId = <tenant id>

### Register tenant: id and apiKey are generated by the server
# identifier: 3-63 chars a-z, 0-9, '-', no leading/trailing '-', not management/www/api
POST {{host}}/api/Tenant/registerTenant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "identifier": "my-tenant",
  "name": "My car service"
}

### Get tenant: GodMode, or a token whose tenant_id matches; no token -> 401
GET {{host}}/api/Tenant/getTenantById?id={{tenantId}}
Authorization: Bearer {{token}}

### Update tenant (identifier cannot be changed)
PATCH {{host}}/api/Tenant/updateTenant
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": "{{tenantId}}",
  "name": "My car service (renamed)",
  "isActive": true
}

### All tenants (GodMode only)
GET {{host}}/api/Tenant/getAllTenants
Authorization: Bearer {{token}}

### Delete tenant
DELETE {{host}}/api/Tenant/deleteTenant?id={{tenantId}}
Authorization: Bearer {{token}}
